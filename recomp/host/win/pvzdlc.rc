// The Windows app's icon (the Switch's picture), manifest and version (Makefile, TARGET=win64)
#include <winuser.h>
1 ICON "pvzdlc.ico"
CREATEPROCESS_MANIFEST_RESOURCE_ID RT_MANIFEST "pvzdlc.manifest"
1 VERSIONINFO
FILEVERSION 0,2,5,0
PRODUCTVERSION 0,2,5,0
BEGIN
  BLOCK "StringFileInfo"
  BEGIN
    BLOCK "040904b0"
    BEGIN
      VALUE "FileDescription", "Plants vs. Zombies: DLC Edition"
      VALUE "ProductName", "Plants vs. Zombies: DLC Edition (Beta 2.5)"
      VALUE "CompanyName", "aks796"
      VALUE "FileVersion", "Beta 2.5"
      VALUE "ProductVersion", "Beta 2.5"
    END
  END
  BLOCK "VarFileInfo"
  BEGIN
    VALUE "Translation", 0x409, 1200
  END
END
